{
  "battery": {
    "interval": 5, // checks every X seconds now
    "states": {
      // "good": 95,
      // "warning": 30,
      // "critical": 20
    },
    "format": "{capacity}% {icon}  {time}  {power}W",
    "rotate": 0,
    "format-charging": "{capacity}%   {time}",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  }
}
